<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile &amp; Settings"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <!-- User Profile Card (Multi-User Supported) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_color"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_color"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_profile" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/tvProfileUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jahnavi"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvProfileUserRole"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Primary Account • Fitness &amp; Health"
                            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Multi-User Switcher Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchUser"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔄 Switch Profile (Multi-User Login)"
                    android:textSize="13sp"
                    android:textColor="@color/colorPrimary"
                    app:strokeColor="@color/colorPrimary"
                    app:cornerRadius="10dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Emergency Helpline 9440085239 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeWidth="1dp"
            app:strokeColor="#FCA5A5"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨 Emergency Helpline (24/7)"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
                        android:textColor="#991B1B"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvHelplineNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Helpline: 9440085239"
                        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                        android:textColor="#B91C1C"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCallHelpline"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Call"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:backgroundTint="#DC2626" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions Menu Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_color"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_color"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnNavWristVitals"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="❤️  Wrist Pulse &amp; BP Health Check"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavDriverDrowsiness"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🚗  Driver Drowsiness Monitor"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="📖  How to Use MotionShield"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavGuide"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="📘  Activity Recognition Guide"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavSafety"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🛡️  Elderly Safety &amp; Precautions"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavInsights"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="📊  Insights &amp; Analytics"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavAbout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ℹ️  About MotionShield &amp; Architecture"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_primary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <TextView
                    android:id="@+id/btnNavDiagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🔧  ML Diagnostics (Developer)"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
