<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_color">

    <!-- Large activity name -->
    <TextView
        android:id="@+id/activityName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="---"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Mascot image -->
    <ImageView
        android:id="@+id/mascotImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_mascot"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Confidence bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <!-- Repeat for each class (0‑5) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WALKING" />
            <ProgressBar android:id="@+id/progress0" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WALKING_UPSTAIRS" />
            <ProgressBar android:id="@+id/progress1" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"         android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="WALKING_DOWNSTAIRS" />
            <ProgressBar android:id="@+id/progress2" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"         android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SITTING" />
            <ProgressBar android:id="@+id/progress3" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"         android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="STANDING" />
            <ProgressBar android:id="@+id/progress4" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"         android:layout_marginBottom="4dp">
            <TextView android:id="@+id/label5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LAYING" />
            <ProgressBar android:id="@+id/progress5" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:max="100" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status texts -->
    <TextView
        android:id="@+id/windowProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Window: 0/128"
        android:layout_marginTop="12dp" />
    <TextView
        android:id="@+id/sensorStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accelerometer: 🟢 OK | Gyroscope: 🟢 OK"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/sessionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READY"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/predictionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Predictions: 0"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/latencyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Latency: 0 ms"
        android:layout_marginTop="4dp" />

    <!-- Control buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start" />
        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pause" />
        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset" />
    </LinearLayout>

</LinearLayout>
